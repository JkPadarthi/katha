# Katha server — environment template.
# Copy to `.env` (gitignored) and fill in. The server reads these via os.environ
# in app/config.py.

# --- Archive storage (D6, D14) ------------------------------------------------
# Root of the md archive (source of truth). Override for tests.
# KATHA_ARCHIVE=./archive

# SQLite index location.
# KATHA_DATA=./data

# Built PWA client served at `/` (same origin, one port). Set by the image.
# In local dev without a build, leave unset — the static mount is skipped.
# KATHA_WEB_DIR=./web

# Browser origins allowed to call the API (comma-separated). Add your
# Tailscale-served preview origin here, e.g. http://100.86.68.51:5173.
# NEVER set back to * — with no auth it lets any webpage rewrite the archive.
KATHA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null

# --- Muse upstream (0.3 Muse, D16/D19) ----------------------------------------
# Friend's jenga box — direct Ollama. Trusted LAN, no API key required.
# Override OLLAMA_BASE for local dev (e.g. http://localhost:11434).
OLLAMA_BASE=http://100.77.183.77:11434

# --- Muse upstream dialect (2.1, D20-D23) ------------------------------------
# "ollama" (default) => the LAN box above, via Ollama-native /api/chat.
# "openai"           => any OpenAI-compatible /chat/completions gateway.
# Switching brains is three vars; switching back is setting this to `ollama`
# again. The OLLAMA_* settings above are left untouched either way.
KATHA_MUSE_API=ollama
# Base URL for openai mode, INCLUDING the version segment, no trailing slash.
# e.g. https://api.commandcode.ai/provider/v1  |  https://openrouter.ai/api/v1
KATHA_MUSE_API_BASE=
# Bearer token for openai mode. Sent as a header only — never logged, never
# returned by any endpoint, never echoed in an error message.
KATHA_MUSE_API_KEY=

# Connect-step budget (seconds). A dead/unreachable upstream must fail in
# seconds and surface as `[ERROR]` in the Muse; without this the UI just
# freezes for the full MUSE_UPSTREAM_TIMEOUT (2.0.1 behavior).
MUSE_UPSTREAM_CONNECT_TIMEOUT=10

# Default Muse model for rewrite, canon sweep, and the style digest.
# (The thinking model — deepseek-r1's planning improves prose output.)
MUSE_REWRITE_MODEL=deepseek-r1:14b

# Agentic chat — the model drives tool calls to read the story files on demand
# (chapters, bible, notes) instead of us sending the chapter. MUST be a
# tool-capable model (gemma4 / qwen3 / llama3.1 …); deepseek-r1 is NOT.
# MUSE_CHAT_MODEL is accepted as a legacy alias for this setting.
MUSE_AGENT_MODEL=gemma4:12b

# Upper bound on tool-call rounds in a single agentic reply (latency guard).
KATHA_MUSE_MAX_TOOL_ROUNDS=6

# Token ceilings. deepseek-r1:14b has 131K context — we cap well below that.
MUSECONTEXT_MAX_TOKENS=6000
MUSE_NUM_PREDICT=4096

# How many prior chapters the Muse reads when building a style fingerprint.
MUSE_STYLE_PROSE_CHAPTERS=3

# HTTP timeout (seconds) for upstream Ollama streaming calls.
MUSE_UPSTREAM_TIMEOUT=300
